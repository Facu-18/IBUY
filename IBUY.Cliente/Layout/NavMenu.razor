<nav class="ibuy-menu @(Abierto ? "abierto" : null)" aria-label="Navegacion principal">
    <div class="menu-scroll">
        @foreach (var grupo in grupos)
        {
            <p class="menu-titulo">@grupo.Titulo</p>
            <ul class="menu-lista">
                @foreach (var opcion in grupo.Opciones)
                {
                    <li>
                        <NavLink class="menu-link" href="@opcion.Ruta" Match="@opcion.Coincidencia">
                            <Icono Nombre="@opcion.Icono" />
                            <span>@opcion.Etiqueta</span>
                        </NavLink>
                    </li>
                }
            </ul>
        }

        <div class="menu-pie">
            <a class="menu-link" href="https://localhost:7209/swagger" target="_blank" rel="noopener noreferrer">
                <Icono Nombre="codigo" />
                <span>Swagger API</span>
            </a>
        </div>
    </div>
</nav>

@code {
    [Parameter]
    public bool Abierto { get; set; }

    private record Opcion(string Etiqueta, string Ruta, string Icono, NavLinkMatch Coincidencia = NavLinkMatch.Prefix);

    private record Grupo(string Titulo, Opcion[] Opciones);

    private static readonly Grupo[] grupos =
    [
        new Grupo("General",
        [
            new Opcion("Dashboard", "", "dashboard", NavLinkMatch.All)
        ]),
        new Grupo("Administracion",
        [
            new Opcion("Empresas", "empresas", "empresas"),
            new Opcion("Usuarios", "usuarios", "usuarios"),
            new Opcion("Depositos", "depositos", "depositos"),
            new Opcion("Productos", "productos", "productos")
        ]),
        new Grupo("Inventario",
        [
            new Opcion("Stock", "stock", "stock"),
            new Opcion("Necesidades", "necesidades", "necesidades"),
            new Opcion("Remitos", "remitos", "remitos")
        ]),
        new Grupo("Compras",
        [
            new Opcion("Notas de pedido", "notas-pedido", "notas"),
            new Opcion("Marketplace", "marketplace", "marketplace"),
            new Opcion("Cotizaciones", "cotizaciones", "cotizaciones")
        ])
    ];
}

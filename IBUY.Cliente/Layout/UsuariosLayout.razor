@inherits LayoutComponentBase
@layout MainLayout
@inject EstadoSesion Sesion
@inject NavigationManager Navegacion

@* Guard solo de interfaz para la seccion Usuarios: solo Ventas y SuperAdmin.
   Sin permiso no se crea la pagina y se vuelve al inicio. La API sigue validando. *@
@if (Sesion.PuedeGestionarUsuarios)
{
    @Body
}

@code {
    protected override void OnParametersSet()
    {
        if (Sesion.EstaLogueado && !Sesion.PuedeGestionarUsuarios)
        {
            Navegacion.NavigateTo("", replace: true);
        }
    }
}

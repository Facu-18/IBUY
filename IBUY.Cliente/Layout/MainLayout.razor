@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navegacion
@inject EstadoSesion Sesion

@if (Sesion.EstaLogueado)
{
    <div class="d-flex flex-column vh-100">
        <Encabezado AlAlternarMenu="AlternarMenu" MenuAbierto="menuAbierto" />

        <div class="d-flex flex-grow-1 overflow-hidden">
            <NavMenu Abierto="menuAbierto" AlCerrar="CerrarMenu" />

            @if (menuAbierto)
            {
                <div class="offcanvas-backdrop fade show d-lg-none" @onclick="CerrarMenu"></div>
            }

            <main class="flex-grow-1 overflow-auto p-3 p-lg-4">
                @Body
            </main>
        </div>
    </div>
}

@code {
    private bool menuAbierto;

    protected override void OnInitialized()
    {
        Navegacion.LocationChanged += AlNavegar;
        Sesion.OnCambio += AlCambiarSesion;
        RedirigirSiNoHaySesion();
    }

    // Guard solo de interfaz: la API sigue abierta. Sin sesion se envia a /login recordando la ruta pedida.
    private void RedirigirSiNoHaySesion()
    {
        if (Sesion.EstaLogueado)
        {
            return;
        }

        var ruta = "/" + Navegacion.ToBaseRelativePath(Navegacion.Uri);
        var destino = ruta == "/" ? "login" : $"login?returnUrl={Uri.EscapeDataString(ruta)}";
        Navegacion.NavigateTo(destino, replace: true);
    }

    // Al cerrar sesion (desde el encabezado) se vuelve al login.
    private void AlCambiarSesion()
    {
        if (!Sesion.EstaLogueado)
        {
            Navegacion.NavigateTo("login", replace: true);
        }

        StateHasChanged();
    }

    private void AlternarMenu() => menuAbierto = !menuAbierto;

    private void CerrarMenu() => menuAbierto = false;

    // En movil el menu se superpone al contenido: al navegar hay que cerrarlo.
    private void AlNavegar(object? emisor, LocationChangedEventArgs argumentos)
    {
        if (menuAbierto)
        {
            menuAbierto = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= AlNavegar;
        Sesion.OnCambio -= AlCambiarSesion;
    }
}

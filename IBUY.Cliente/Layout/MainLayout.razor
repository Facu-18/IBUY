@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager Navegacion

<div class="d-flex flex-column vh-100">
    <Encabezado AlAlternarMenu="AlternarMenu" MenuAbierto="menuAbierto" />

    <div class="d-flex flex-grow-1 overflow-hidden">
        <NavMenu Abierto="menuAbierto" AlCerrar="CerrarMenu" />

        @if (menuAbierto)
        {
            <div class="offcanvas-backdrop fade show d-lg-none" @onclick="CerrarMenu"></div>
        }

        <main class="flex-grow-1 overflow-auto bg-body-tertiary p-3 p-lg-4">
            @Body
        </main>
    </div>
</div>

@code {
    private bool menuAbierto;

    protected override void OnInitialized()
    {
        Navegacion.LocationChanged += AlNavegar;
    }

    private void AlternarMenu() => menuAbierto = !menuAbierto;

    private void CerrarMenu() => menuAbierto = false;

    // En movil el menu se superpone al contenido: al navegar hay que cerrarlo.
    private void AlNavegar(object? emisor, LocationChangedEventArgs argumentos)
    {
        if (menuAbierto)
        {
            menuAbierto = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Navegacion.LocationChanged -= AlNavegar;
    }
}

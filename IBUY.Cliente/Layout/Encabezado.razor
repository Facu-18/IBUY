@implements IDisposable
@inject EstadoSesion Sesion
@inject ICatalogoServicio Catalogo

<header class="d-flex align-items-center gap-3 bg-white border-bottom px-3 py-3">
    <button type="button" class="btn btn-outline-secondary d-lg-none" @onclick="AlAlternarMenu"
            aria-label="@(MenuAbierto ? "Cerrar menu" : "Abrir menu")" aria-expanded="@MenuAbierto">
        <Icono Nombre="@(MenuAbierto ? "cerrar" : "menu")" />
    </button>

    <a class="d-flex align-items-center gap-2 text-decoration-none text-body" href="">
        <span class="ibuy-logo">iB</span>
        <span class="d-flex flex-column lh-sm">
            <strong class="ibuy-marca">IBUY</strong>
            <small class="text-body-secondary d-none d-md-inline">Plataforma de compras y stock</small>
        </span>
    </a>

    <div class="ms-auto">
        <select class="form-select" aria-label="Empresa seleccionada"
                value="@Sesion.EmpresaId" @onchange="AlCambiarEmpresa" disabled="@(empresas.Count == 0)">
            @if (empresas.Count == 0)
            {
                <option value="0">Sin empresas</option>
            }
            else
            {
                @foreach (var empresa in empresas)
                {
                    <option value="@empresa.Id">@empresa.RazonSocial</option>
                }
            }
        </select>

    </div>
</header>

@code {
    private List<EmpresaDTO> empresas = [];

    [Parameter]
    public EventCallback AlAlternarMenu { get; set; }

    [Parameter]
    public bool MenuAbierto { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var respuesta = await Catalogo.ObtenerEmpresasAsync();
        if (!respuesta.Error && respuesta.Respuesta is not null)
        {
            empresas = respuesta.Respuesta;

            // Primera carga: toma la primera empresa como activa.
            if (Sesion.EmpresaId == 0 && empresas.Count > 0)
            {
                Sesion.CambiarEmpresa(empresas[0].Id, empresas[0].RazonSocial);
            }
        }

        Sesion.OnCambio += Refrescar;
    }

    private void AlCambiarEmpresa(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var empresaId))
        {
            return;
        }

        var empresa = empresas.FirstOrDefault(x => x.Id == empresaId);
        if (empresa is not null)
        {
            Sesion.CambiarEmpresa(empresa.Id, empresa.RazonSocial);
        }
    }

    private void Refrescar() => StateHasChanged();

    public void Dispose()
    {
        Sesion.OnCambio -= Refrescar;
    }
}

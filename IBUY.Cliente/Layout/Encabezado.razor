@implements IDisposable
@inject EstadoSesion Sesion

<header class="d-flex align-items-center gap-3 bg-white border-bottom px-3 py-3">
    <button type="button" class="btn btn-outline-secondary d-lg-none" @onclick="AlAlternarMenu"
            aria-label="@(MenuAbierto ? "Cerrar menu" : "Abrir menu")" aria-expanded="@MenuAbierto">
        <Icono Nombre="@(MenuAbierto ? "cerrar" : "menu")" />
    </button>

    <a class="d-flex align-items-center gap-2 text-decoration-none text-body" href="">
        <span class="d-flex flex-column gap-1 lh-sm">
            <Marca />
            <small class="text-body-secondary d-none d-md-inline">Plataforma de compras y stock</small>
        </span>
    </a>

    @if (Sesion.Usuario is not null)
    {
        <div class="ms-auto d-flex align-items-center gap-3">
            <div class="d-flex flex-column lh-sm text-end">
                <strong>@Sesion.Usuario.Nombre</strong>
                <small class="text-body-secondary d-none d-md-inline">@Sesion.Usuario.EmpresaRazonSocial</small>
            </div>
            <span class="badge text-bg-primary d-none d-sm-inline">@Sesion.Usuario.Rol</span>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="CerrarSesion">Cerrar sesión</button>
        </div>
    }
</header>

@code {
    [Parameter]
    public EventCallback AlAlternarMenu { get; set; }

    [Parameter]
    public bool MenuAbierto { get; set; }

    protected override void OnInitialized()
    {
        Sesion.OnCambio += Refrescar;
    }

    private async Task CerrarSesion()
    {
        await Sesion.CerrarSesionAsync();
    }

    private void Refrescar() => StateHasChanged();

    public void Dispose()
    {
        Sesion.OnCambio -= Refrescar;
    }
}

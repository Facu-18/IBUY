@page "/empresas/nuevo"
@page "/empresas/editar/{Id:int}"
@inject IEmpresaServicio EmpresaServicio
@inject NavigationManager Navegacion

<PageTitle>@(esEdicion ? "Editar empresa" : "Nueva empresa") · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">@(esEdicion ? "Editar empresa" : "Nueva empresa")</h1>
    <p class="text-body-secondary mb-0">@(esEdicion ? "Actualiza los datos de la empresa." : "Registra una empresa nueva en la plataforma.")</p>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando formulario..." />
}
else if (empresa is null)
{
    <div class="alert alert-danger" role="alert">
        No se encontro la empresa solicitada.
        <a class="alert-link" href="empresas">Volver al listado</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorServidor))
    {
        <div class="alert alert-danger" role="alert">@errorServidor</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="empresa" OnValidSubmit="Guardar" OnInvalidSubmit="MarcarInvalido">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="empresa-razon-social">Razon social</label>
                    <InputText id="empresa-razon-social" class="form-control" @bind-Value="empresa!.RazonSocial" maxlength="100" placeholder="Ej.: Constructora del Sur SA" />
                    <ValidationMessage class="text-danger small" For="() => empresa!.RazonSocial" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="empresa-cuit">CUIT</label>
                        <InputText id="empresa-cuit" class="form-control" @bind-Value="empresa!.Cuit" maxlength="13" placeholder="Ej.: 30-71234567-8" />
                        <ValidationMessage class="text-danger small" For="() => empresa!.Cuit" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="empresa-tipo">Tipo</label>
                        <InputSelect id="empresa-tipo" class="form-select" @bind-Value="empresa!.Tipo">
                            <option value="">Seleccione un tipo</option>
                            @foreach (var tipo in tipos)
                            {
                                <option value="@tipo">@tipo</option>
                            }
                        </InputSelect>
                        <ValidationMessage class="text-danger small" For="() => empresa!.Tipo" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="empresa-rubro">Rubro</label>
                    <InputText id="empresa-rubro" class="form-control" @bind-Value="empresa!.Rubro" maxlength="50" placeholder="Ej.: Materiales de construccion" />
                    <ValidationMessage class="text-danger small" For="() => empresa!.Rubro" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="empresa-email">Email</label>
                    <InputText id="empresa-email" type="email" class="form-control" @bind-Value="empresa!.Email" maxlength="100" placeholder="Ej.: contacto@empresa.com" />
                    <ValidationMessage class="text-danger small" For="() => empresa!.Email" />
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="empresa!.Activo" id="empresa-activo" class="form-check-input" />
                    <label class="form-check-label" for="empresa-activo">Empresa activa</label>
                </div>

                @if (intentado)
                {
                    <div class="alert alert-danger" role="alert">
                        <ValidationSummary class="mb-0" />
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" href="empresas">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private EmpresaDTO? empresa;
    private List<string> tipos = [];
    private bool cargando = true;
    private bool guardando;
    private bool intentado;
    private string? errorServidor;

    private bool esEdicion => Id.HasValue && Id.Value > 0;

    protected override async Task OnInitializedAsync()
    {
        tipos = ["Compradora", "Proveedora"];

        empresa = new EmpresaDTO { Activo = true };

        if (esEdicion)
        {
            var respuesta = await EmpresaServicio.ObtenerPorIdAsync(Id!.Value);
            if (respuesta.Error || respuesta.Respuesta is null)
            {
                errorServidor = $"No se encontro la empresa de id: {Id}. {respuesta.Mensaje}".Trim();
                empresa = null;
            }
            else
            {
                empresa = respuesta.Respuesta;
                empresa.Id = Id!.Value;

                // El tipo viene de la base: si no esta entre las opciones conocidas se agrega.
                if (!string.IsNullOrWhiteSpace(empresa.Tipo) && !tipos.Contains(empresa.Tipo))
                {
                    tipos.Add(empresa.Tipo);
                }
            }
        }

        cargando = false;
    }

    private void MarcarInvalido()
    {
        intentado = true;
    }

    private async Task Guardar()
    {
        if (empresa is null)
        {
            return;
        }

        intentado = false;
        guardando = true;
        errorServidor = null;

        if (esEdicion)
        {
            var respuesta = await EmpresaServicio.EditarAsync(Id!.Value, empresa);
            if (respuesta.Error || !respuesta.Respuesta)
            {
                errorServidor = $"No se pudo guardar la empresa. {respuesta.Mensaje}".Trim();
                guardando = false;
                return;
            }

            Navegacion.NavigateTo($"empresas/{Id!.Value}");
            return;
        }

        var creacion = await EmpresaServicio.CrearAsync(empresa);
        if (creacion.Error)
        {
            errorServidor = $"No se pudo crear la empresa. {creacion.Mensaje}".Trim();
            guardando = false;
            return;
        }

        Navegacion.NavigateTo($"empresas/{creacion.Respuesta}");
    }
}

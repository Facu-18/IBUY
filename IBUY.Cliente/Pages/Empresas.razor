@page "/empresas"
@inject IEmpresaServicio EmpresaServicio
@inject IJSRuntime JS

<PageTitle>Empresas · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Empresas</h1>
    <p class="text-body-secondary mb-0">Empresas registradas en la plataforma.</p>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando empresas..." />
}
else if (errorCarga is not null)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}
else
{
    <div class="d-flex flex-wrap align-items-end gap-3 mb-3">
        <div class="col-12 col-lg-5 col-xl-4">
            <label class="input-group">
                <span class="input-group-text"><Icono Nombre="buscar" /></span>
                <input type="text" class="form-control" placeholder="Buscar por razon social o CUIT"
                       aria-label="Buscar empresas" @bind="busqueda" @bind:event="oninput" />
            </label>
        </div>

        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <label class="form-label" for="empresas-tipo">Tipo</label>
            <select id="empresas-tipo" class="form-select" @bind="tipoFiltro">
                <option value="">Todos</option>
                @foreach (var tipo in tipos)
                {
                    <option value="@tipo">@tipo</option>
                }
            </select>
        </div>

        <div class="col-6 col-md-4 col-lg-3 col-xl-2">
            <label class="form-label" for="empresas-estado">Estado</label>
            <select id="empresas-estado" class="form-select" @bind="estadoFiltro">
                <option value="todas">Todas</option>
                <option value="activas">Activas</option>
                <option value="inactivas">Inactivas</option>
            </select>
        </div>

        <span class="text-body-secondary pb-2">@filtrados.Count @(filtrados.Count == 1 ? "empresa" : "empresas")</span>

        <a class="btn btn-primary d-inline-flex align-items-center gap-2 ms-md-auto" href="empresas/nuevo">
            <Icono Nombre="mas" />
            Nueva empresa
        </a>
    </div>

    <div class="card shadow-sm">
        @if (empresas.Count == 0)
        {
            <p class="text-center text-body-secondary py-5 mb-0">Todavia no hay empresas cargadas.</p>
        }
        else if (filtrados.Count == 0)
        {
            <p class="text-center text-body-secondary py-5 mb-0">Sin resultados para la busqueda.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Razon social</th>
                            <th>CUIT</th>
                            <th>Tipo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var empresa in filtrados)
                        {
                            <tr @key="empresa.Id">
                                <td class="fw-semibold">@empresa.RazonSocial</td>
                                <td>@empresa.Cuit</td>
                                <td><span class="badge rounded-pill bg-primary-subtle text-primary-emphasis">@empresa.Tipo</span></td>
                                <td>
                                    <span class="badge rounded-pill @(empresa.Activo ? "bg-success-subtle text-success-emphasis" : "bg-warning-subtle text-warning-emphasis")">
                                        @(empresa.Activo ? "Activa" : "Inactiva")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap justify-content-end gap-1">
                                        <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="@($"empresas/{empresa.Id}")">
                                            <Icono Nombre="ver" /> Ver
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" href="@($"empresas/editar/{empresa.Id}")">
                                            <Icono Nombre="editar" /> Editar
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm @(empresa.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                                disabled="@guardando"
                                                @onclick="() => AlternarEstado(empresa)">
                                            @(empresa.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (aviso is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show text-bg-dark border-0" role="status">
            <div class="toast-body">@aviso</div>
        </div>
    </div>
}

@code {
    private List<EmpresaDTO> empresas = [];
    private string busqueda = string.Empty;
    private string tipoFiltro = string.Empty;
    private string estadoFiltro = "todas";
    private bool cargando = true;
    private bool guardando;
    private string? errorCarga;
    private string? aviso;

    private List<string> tipos => [.. empresas.Select(e => e.Tipo).Where(t => !string.IsNullOrWhiteSpace(t)).Distinct().OrderBy(t => t)];

    private List<EmpresaDTO> filtrados => [.. empresas.Where(Coincide)];

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        cargando = true;
        errorCarga = null;
        StateHasChanged();

        var respuesta = await EmpresaServicio.ObtenerTodasAsync();

        if (respuesta.Error)
        {
            empresas = [];
            errorCarga = $"No se pudieron cargar las empresas. {respuesta.Mensaje}".Trim();
        }
        else
        {
            empresas = (respuesta.Respuesta ?? []).OrderBy(e => e.RazonSocial).ToList();
        }

        cargando = false;
        StateHasChanged();
    }

    private bool Coincide(EmpresaDTO empresa)
    {
        if (!string.IsNullOrWhiteSpace(tipoFiltro) &&
            !string.Equals(empresa.Tipo, tipoFiltro, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        if (estadoFiltro == "activas" && !empresa.Activo)
        {
            return false;
        }

        if (estadoFiltro == "inactivas" && empresa.Activo)
        {
            return false;
        }

        if (string.IsNullOrWhiteSpace(busqueda))
        {
            return true;
        }

        var filtro = busqueda.Trim().ToLowerInvariant();
        return empresa.RazonSocial.ToLowerInvariant().Contains(filtro)
            || empresa.Cuit.ToLowerInvariant().Contains(filtro);
    }

    private async Task AlternarEstado(EmpresaDTO empresa)
    {
        if (empresa.Activo)
        {
            var confirmado = await JS.InvokeAsync<bool>("confirm", $"Desactivar la empresa {empresa.RazonSocial}?");
            if (!confirmado)
            {
                return;
            }
        }

        guardando = true;

        var actualizado = new EmpresaDTO
        {
            Id = empresa.Id,
            RazonSocial = empresa.RazonSocial,
            Rubro = empresa.Rubro,
            Cuit = empresa.Cuit,
            Email = empresa.Email,
            Tipo = empresa.Tipo,
            Activo = !empresa.Activo
        };

        var respuesta = await EmpresaServicio.EditarAsync(empresa.Id, actualizado);

        if (respuesta.Error || !respuesta.Respuesta)
        {
            await MostrarAviso($"No se pudo actualizar {empresa.RazonSocial}. {respuesta.Mensaje}".Trim());
        }
        else
        {
            // La operacion se refleja en el listado sin volver a pedir los datos.
            empresa.Activo = actualizado.Activo;
            await MostrarAviso(actualizado.Activo
                ? $"{empresa.RazonSocial} activada."
                : $"{empresa.RazonSocial} desactivada.");
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task MostrarAviso(string texto)
    {
        aviso = texto;
        StateHasChanged();

        await Task.Delay(3500);

        if (aviso == texto)
        {
            aviso = null;
            StateHasChanged();
        }
    }
}

@page "/"
@layout MainLayout
@inject EstadoSesion Sesion

<PageTitle>Inicio · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Bienvenido, @Sesion.Usuario?.Nombre</h1>
    <p class="text-body-secondary mb-0">@Sesion.Empresa · @NombreRol(Sesion.Usuario?.Rol)</p>
</div>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var seccion in SeccionesNavegacion.DeInicio(Sesion))
    {
        <div class="col">
            <a class="card h-100 shadow-sm text-decoration-none text-body" href="@seccion.Ruta">
                <div class="card-body d-flex flex-column gap-3 p-4">
                    <span class="d-inline-flex align-items-center justify-content-center rounded-3 bg-primary-subtle text-primary-emphasis p-3 align-self-start">
                        <Icono Nombre="@seccion.Icono" />
                    </span>
                    <h2 class="h5 mb-0">@seccion.Titulo</h2>
                    @if (seccion.Disponibilidad is not null)
                    {
                        <span class="badge rounded-pill bg-secondary-subtle text-secondary-emphasis align-self-start">@seccion.Disponibilidad</span>
                    }
                    <p class="text-body-secondary mb-0">@seccion.Descripcion</p>
                </div>
            </a>
        </div>
    }
</div>

@code {
    private static string NombreRol(string? rol) => rol switch
    {
        Roles.EncargadoDeposito => "Encargado de depósito",
        Roles.Ventas => "Ventas",
        Roles.SuperAdmin => "SuperAdmin",
        _ => rol ?? string.Empty
    };
}

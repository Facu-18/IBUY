@page "/stock/{Id:int}"
@implements IDisposable
@inject IStockServicio StockServicio
@inject SimulacionStock Simulacion

<PageTitle>@(stock is null ? "Stock" : $"Stock de {stock.ProductoNombre}") · IBUY</PageTitle>

@if (cargando)
{
    <Cargando Texto="Cargando stock..." />
}
else if (stock is null)
{
    <div class="alert alert-danger" role="alert">
        No se pudo cargar el stock. @errorCarga
        <a class="alert-link" href="stock">Volver al stock</a>
    </div>
}
else
{
    var vista = Simulacion.Simular(stock);

    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@stock.ProductoNombre</h1>
            <p class="text-body-secondary mb-0">
                <a class="link-primary text-decoration-none" href="@($"stock/deposito/{stock.DepositoId}")">@stock.DepositoNombre</a>
                · @stock.Categoria
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="stock">
                <Icono Nombre="volver" /> Volver
            </a>
            <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="@($"stock/{Id}/minimo")">
                <Icono Nombre="editar" /> Cantidad minima
            </a>
        </div>
    </div>

    @if (Simulacion.EsSimulado(Id))
    {
        <div class="alert alert-info d-flex flex-wrap align-items-center justify-content-between gap-2" role="status">
            <span>
                Ajuste simulado: en pantalla la cantidad es @vista.CantidadActual.ToString("0.##");
                la real sigue siendo @stock.CantidadActual.ToString("0.##").
            </span>
            <button type="button" class="btn btn-sm btn-outline-info" @onclick="() => Simulacion.Descartar(Id)">Descartar simulacion</button>
        </div>
    }

    <div class="card shadow-sm @(EstadosStock.EsCritico(vista.Estado) ? "border-warning" : string.Empty)">
        <div class="card-body">
            <dl class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-0">
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Estado</dt>
                    <dd class="mb-0"><BadgeEstadoStock Estado="@vista.Estado" /></dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Cantidad actual</dt>
                    <dd class="mb-0 h4">@vista.CantidadActual.ToString("0.##")</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Cantidad minima</dt>
                    <dd class="mb-0 h4">@(vista.CantidadMinima > 0 ? vista.CantidadMinima.ToString("0.##") : "Sin minimo")</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Deposito</dt>
                    <dd class="mb-0">@stock.DepositoNombre</dd>
                </div>
            </dl>
        </div>
    </div>

    <p class="text-body-secondary small mt-3 mb-0">
        Estado: agotado sin existencias, bajo si la cantidad no supera el minimo, normal en otro caso.
        La cantidad real solo cambia con remitos.
    </p>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private StockListadoDTO? stock;
    private bool cargando = true;
    private string? errorCarga;

    protected override void OnInitialized() => Simulacion.OnCambio += AlCambiarSimulacion;

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        var respuesta = await StockServicio.ObtenerPorIdAsync(Id);
        stock = respuesta.Error ? null : respuesta.Respuesta;
        errorCarga = respuesta.Error ? respuesta.Mensaje : null;
        cargando = false;
    }

    private void AlCambiarSimulacion() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Simulacion.OnCambio -= AlCambiarSimulacion;
}

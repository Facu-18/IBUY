@page "/marketplace"
@implements IDisposable
@inject INotaPedidoServicio NotaPedidoServicio
@inject ICotizacionServicio CotizacionServicio
@inject EstadoSesion Sesion

<PageTitle>Marketplace · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Marketplace</h1>
    <p class="text-body-secondary mb-0">Notas de pedido publicadas por otras empresas, disponibles para cotizar.</p>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando oportunidades..." />
}
else if (errorCarga is not null)
{
    <div class="alert alert-danger" role="alert">
        @errorCarga
        <button class="btn btn-sm btn-outline-danger ms-2" @onclick="Cargar">Reintentar</button>
    </div>
}
else
{
    <div class="row g-3 align-items-end mb-3">
        <div class="col-12 col-lg-5">
            <label class="form-label" for="marketplace-busqueda">Buscar por producto</label>
            <div class="input-group">
                <span class="input-group-text"><Icono Nombre="buscar" /></span>
                <input id="marketplace-busqueda" type="search" class="form-control" placeholder="Nombre del producto"
                       @bind="busqueda" @bind:event="oninput" />
            </div>
        </div>
        <div class="col-12 col-lg-7" role="status">
            <p class="text-body-secondary mb-0 pb-2">
                @(filtradas.Count == 1 ? "1 oportunidad" : $"{filtradas.Count} oportunidades")
            </p>
        </div>
    </div>

    @if (oportunidades.Count == 0)
    {
        <div class="card shadow-sm">
            <p class="text-center text-body-secondary py-5 px-3 mb-0">
                No hay notas de pedido publicadas y vigentes de otras empresas para cotizar.
            </p>
        </div>
    }
    else if (filtradas.Count == 0)
    {
        <div class="card shadow-sm">
            <p class="text-center text-body-secondary py-5 px-3 mb-0">
                No hay oportunidades que coincidan con la búsqueda.
            </p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var oportunidad in filtradas)
            {
                <div class="col-12 col-md-6 col-xxl-4" @key="oportunidad.Id">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column gap-3">
                            <div class="d-flex justify-content-between align-items-start gap-2">
                                <div>
                                    <h2 class="h5 mb-1">@oportunidad.EmpresaNombre</h2>
                                    <span class="small text-body-secondary">Nota N.º @oportunidad.Id</span>
                                </div>
                                <span class="badge rounded-pill flex-shrink-0 @ClaseVencimiento(oportunidad)">
                                    @TextoVencimiento(oportunidad)
                                </span>
                            </div>

                            @if (string.IsNullOrWhiteSpace(oportunidad.Observaciones))
                            {
                                <p class="text-body-secondary fst-italic mb-0">Sin observaciones.</p>
                            }
                            else
                            {
                                <p class="text-body-secondary mb-0">@oportunidad.Observaciones</p>
                            }

                            <div class="table-responsive">
                                <table class="table table-sm align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th scope="col">Producto</th>
                                            <th scope="col" class="text-end">Cantidad</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in oportunidad.Items)
                                        {
                                            <tr @key="item.Id">
                                                <td class="fw-semibold">@item.ProductoNombre</td>
                                                <td class="text-end">@item.CantidadSolicitada.ToString("0.##")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-auto">
                                <span class="small text-body-secondary">
                                    Vence el @oportunidad.FechaVencimiento.ToString("dd/MM/yyyy")
                                </span>
                                <button type="button"
                                        class="btn @(oportunidad.Cotizada ? "btn-success" : "btn-primary")"
                                        disabled="@oportunidad.Cotizada"
                                        aria-label="@(oportunidad.Cotizada ? "Nota ya cotizada" : $"Cotizar nota N.º {oportunidad.Id}")"
                                        @onclick="() => AbrirModal(oportunidad)">
                                    @(oportunidad.Cotizada ? "Cotizada ✓" : "Cotizar")
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}

@if (seleccionada is not null)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="cotizar-titulo"
         @onclick="CerrarModal">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <h2 class="modal-title h5 mb-1" id="cotizar-titulo">Cotizar nota N.º @seleccionada.Id</h2>
                        <span class="small text-body-secondary">@seleccionada.EmpresaNombre</span>
                    </div>
                    <button type="button" class="btn-close" aria-label="Cerrar" disabled="@enviando" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body">
                    @if (errorEnvio is not null)
                    {
                        <div class="alert alert-danger" role="alert">@errorEnvio</div>
                    }

                    @if (mensajeValidacion is not null)
                    {
                        <div class="alert alert-danger" role="alert">@mensajeValidacion</div>
                    }

                    <div class="table-responsive mb-4">
                        <table class="table table-sm align-middle mb-0">
                            <thead>
                                <tr>
                                    <th scope="col">Producto</th>
                                    <th scope="col" class="text-end">Cant. solicitada</th>
                                    <th scope="col" class="text-end">Cant. ofertada</th>
                                    <th scope="col" class="text-end">Precio unit.</th>
                                    <th scope="col" class="text-end">Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var oferta in ofertas)
                                {
                                    <tr @key="oferta.Item.Id">
                                        <td class="fw-semibold">@oferta.Item.ProductoNombre</td>
                                        <td class="text-end">@oferta.Item.CantidadSolicitada.ToString("0.##")</td>
                                        <td class="text-end">
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   step="0.01" min="0.01" disabled="@enviando"
                                                   aria-label="@($"Cantidad ofertada de {oferta.Item.ProductoNombre}")"
                                                   @bind="oferta.CantidadOfertada" @bind:event="oninput" />
                                        </td>
                                        <td class="text-end">
                                            <input type="number" class="form-control form-control-sm text-end"
                                                   step="0.01" min="0.01" disabled="@enviando"
                                                   aria-label="@($"Precio unitario de {oferta.Item.ProductoNombre}")"
                                                   @bind="oferta.PrecioUnitario" @bind:event="oninput" />
                                        </td>
                                        <td class="text-end fw-semibold">@oferta.PrecioTotal.ToString("C2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="row g-3 align-items-end">
                        <div class="col-12 col-md-7">
                            <label class="form-label" for="cotizacion-plazo">Plazo de entrega *</label>
                            <input id="cotizacion-plazo" class="form-control" maxlength="50" disabled="@enviando"
                                   placeholder="Ej.: 5 días hábiles" @bind="plazoEntrega" />
                            <div class="form-text">Indique cuándo podría entregar los productos.</div>
                        </div>
                        <div class="col-12 col-md-5 text-md-end">
                            <span class="text-body-secondary">Total estimado</span>
                            <div class="fs-4 fw-bold">@TotalEstimado.ToString("C2")</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@enviando" @onclick="CerrarModal">
                        Cancelar
                    </button>
                    <button type="button" class="btn btn-primary" disabled="@enviando" @onclick="Enviar">
                        @if (enviando)
                        {
                            <span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>
                        }
                        @(enviando ? "Enviando..." : "Enviar cotización")
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private List<Oportunidad> oportunidades = [];
    private Oportunidad? seleccionada;
    private List<OfertaItem> ofertas = [];
    private string busqueda = string.Empty;
    private string plazoEntrega = string.Empty;
    private bool cargando = true;
    private bool enviando;
    private string? errorCarga;
    private string? errorEnvio;
    private string? mensajeValidacion;
    private int versionCarga;

    private List<Oportunidad> filtradas => string.IsNullOrWhiteSpace(busqueda)
        ? oportunidades
        : [.. oportunidades.Where(o => o.Items.Any(i =>
            i.ProductoNombre.Contains(busqueda.Trim(), StringComparison.OrdinalIgnoreCase)))];

    private decimal TotalEstimado => ofertas.Sum(o => o.PrecioTotal);

    private int usuarioCargado;

    protected override async Task OnInitializedAsync()
    {
        Sesion.OnCambio += AlCambiarSesion;
        usuarioCargado = Sesion.Usuario?.UsuarioId ?? 0;
        await Cargar();
    }

    private void AlCambiarSesion()
    {
        // Elegir otro deposito en el selector global no cambia el marketplace.
        var usuarioId = Sesion.Usuario?.UsuarioId ?? 0;
        if (usuarioId == usuarioCargado)
        {
            return;
        }

        usuarioCargado = usuarioId;
        _ = InvokeAsync(Cargar);
    }

    private async Task Cargar()
    {
        var version = ++versionCarga;
        var empresaId = Sesion.EmpresaId;

        cargando = empresaId > 0;
        errorCarga = null;
        oportunidades = [];
        busqueda = string.Empty;
        seleccionada = null;
        ofertas = [];
        plazoEntrega = string.Empty;
        errorEnvio = null;
        mensajeValidacion = null;
        enviando = false;
        StateHasChanged();

        if (!cargando)
        {
            return;
        }

        // El servidor ya filtra: Publicadas, no vencidas, de otras empresas y si ya se cotizaron.
        var respuesta = await NotaPedidoServicio.ObtenerMarketplaceAsync();

        // Una respuesta anterior no debe sobrescribir la sesion actual.
        if (version != versionCarga || empresaId != Sesion.EmpresaId)
        {
            return;
        }

        if (respuesta.Error)
        {
            errorCarga = $"No se pudieron cargar las oportunidades. {respuesta.Mensaje}".Trim();
            cargando = false;
            StateHasChanged();
            return;
        }

        oportunidades = (respuesta.Respuesta ?? []).Select(nota => new Oportunidad
        {
            Id = nota.Id,
            EmpresaNombre = string.IsNullOrWhiteSpace(nota.EmpresaRazonSocial)
                ? $"Empresa N.º {nota.EmpresaId}"
                : nota.EmpresaRazonSocial,
            Observaciones = nota.Observaciones,
            FechaVencimiento = nota.FechaVencimiento,
            Items = nota.Items ?? [],
            Cotizada = nota.Cotizada
        }).ToList();

        cargando = false;
        StateHasChanged();
    }

    private void AbrirModal(Oportunidad oportunidad)
    {
        if (oportunidad.Cotizada || Sesion.EmpresaId == 0)
        {
            return;
        }

        seleccionada = oportunidad;
        ofertas = oportunidad.Items.Select(i => new OfertaItem
        {
            Item = i,
            CantidadOfertada = i.CantidadSolicitada
        }).ToList();
        plazoEntrega = string.Empty;
        errorEnvio = null;
        mensajeValidacion = null;
        enviando = false;
    }

    private void CerrarModal()
    {
        if (enviando)
        {
            return;
        }

        seleccionada = null;
        ofertas = [];
        plazoEntrega = string.Empty;
        errorEnvio = null;
        mensajeValidacion = null;
    }

    private async Task Enviar()
    {
        if (seleccionada is null || enviando)
        {
            return;
        }

        errorEnvio = null;
        mensajeValidacion = null;

        if (string.IsNullOrWhiteSpace(plazoEntrega))
        {
            mensajeValidacion = "El plazo de entrega es obligatorio.";
            return;
        }

        foreach (var oferta in ofertas)
        {
            if (oferta.CantidadOfertada <= 0)
            {
                mensajeValidacion = $"La cantidad ofertada de {oferta.Item.ProductoNombre} debe ser mayor a cero.";
                return;
            }

            if (oferta.PrecioUnitario <= 0)
            {
                mensajeValidacion = $"El precio unitario de {oferta.Item.ProductoNombre} debe ser mayor a cero.";
                return;
            }
        }

        var oportunidad = seleccionada;
        var empresaId = Sesion.EmpresaId;

        var cotizacion = new CotizacionDTO
        {
            Estado = "Enviada",
            PlazoEntrega = plazoEntrega.Trim(),
            FechaEnvio = DateTime.Today,
            NotaPedidoId = oportunidad.Id,
            EmpresaProveedoraId = empresaId,
            Items = ofertas.Select(o => new ItemCotizacionDTO
            {
                ItemNotaId = o.Item.Id,
                CantidadOfertada = o.CantidadOfertada,
                PrecioUnitario = o.PrecioUnitario,
                PrecioTotal = o.PrecioTotal
            }).ToList()
        };

        enviando = true;
        var respuesta = await CotizacionServicio.CrearAsync(cotizacion);

        // La empresa pudo cambiar mientras se enviaba la cotización.
        if (empresaId != Sesion.EmpresaId || !ReferenceEquals(seleccionada, oportunidad))
        {
            enviando = false;
            return;
        }

        enviando = false;

        if (respuesta.Error || respuesta.Respuesta <= 0)
        {
            errorEnvio = $"No se pudo enviar la cotización. {respuesta.Mensaje}".Trim();
            StateHasChanged();
            return;
        }

        oportunidad.Cotizada = true;
        seleccionada = null;
        ofertas = [];
        plazoEntrega = string.Empty;
        StateHasChanged();
    }

    private static string ClaseVencimiento(Oportunidad oportunidad)
    {
        return oportunidad.DiasRestantes <= 3
            ? "bg-warning-subtle text-warning-emphasis"
            : "bg-success-subtle text-success-emphasis";
    }

    private static string TextoVencimiento(Oportunidad oportunidad)
    {
        return oportunidad.DiasRestantes switch
        {
            0 => "Vence hoy",
            1 => "Vence en 1 día",
            _ => $"Vence en {oportunidad.DiasRestantes} días"
        };
    }

    public void Dispose()
    {
        versionCarga++;
        Sesion.OnCambio -= AlCambiarSesion;
    }

    private sealed class Oportunidad
    {
        public int Id { get; init; }

        public string EmpresaNombre { get; init; } = string.Empty;

        public string Observaciones { get; init; } = string.Empty;

        public DateTime FechaVencimiento { get; init; }

        public List<ItemNotaDTO> Items { get; init; } = [];

        public bool Cotizada { get; set; }

        public int DiasRestantes => (FechaVencimiento.Date - DateTime.Today).Days;
    }

    private sealed class OfertaItem
    {
        public ItemNotaDTO Item { get; init; } = new();

        public decimal CantidadOfertada { get; set; }

        public decimal PrecioUnitario { get; set; }

        public decimal PrecioTotal => Math.Round(
            CantidadOfertada * PrecioUnitario,
            2,
            MidpointRounding.AwayFromZero);
    }
}

@page "/productos/{Id:int}"
@implements IDisposable
@inject IProductoServicio ProductoServicio
@inject EstadoSesion Sesion

<PageTitle>@(producto?.Nombre ?? "Detalle de producto") · IBUY</PageTitle>

<div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
    <div>
        <h1 class="h3 mb-1">@(producto?.Nombre ?? "Detalle de producto")</h1>
        <p class="text-body-secondary mb-0">Informacion del catalogo de @Sesion.Empresa.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-secondary" href="productos"><Icono Nombre="volver" /> Volver</a>
        @if (producto is not null)
        {
            <a class="btn btn-primary" href="@($"productos/editar/{Id}")"><Icono Nombre="editar" /> Editar producto</a>
        }
    </div>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando producto..." />
}
else if (producto is null)
{
    <div class="alert alert-warning" role="alert">@error</div>
}
else
{
    @if (Guardado)
    {
        <div class="alert alert-success" role="status">El producto se guardo correctamente.</div>
    }
    <div class="card shadow-sm">
        <div class="card-body p-3 p-md-4">
            <dl class="row g-4 mb-0">
                <div class="col-12 col-md-6">
                    <dt class="small text-body-secondary mb-1">Nombre</dt>
                    <dd class="text-break mb-0">@producto.Nombre</dd>
                </div>
                <div class="col-12 col-md-6">
                    <dt class="small text-body-secondary mb-1">Categoria</dt>
                    <dd class="text-break mb-0">@producto.Categoria</dd>
                </div>
                <div class="col-12 col-md-6">
                    <dt class="small text-body-secondary mb-1">Empresa</dt>
                    <dd class="mb-0">@Sesion.Empresa</dd>
                </div>
                <div class="col-12">
                    <dt class="small text-body-secondary mb-1">Descripcion</dt>
                    <dd class="text-break mb-0">@(string.IsNullOrWhiteSpace(producto.Descripcion) ? "Sin descripcion." : producto.Descripcion)</dd>
                </div>
            </dl>
        </div>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    [SupplyParameterFromQuery] public bool Guardado { get; set; }
    private ProductoDTO? producto;
    private string? error;
    private bool cargando = true;
    private int versionCarga;

    protected override void OnInitialized() => Sesion.OnCambio += AlCambiarEmpresa;
    protected override Task OnParametersSetAsync() => Cargar();

    private void AlCambiarEmpresa() => _ = InvokeAsync(Cargar);

    private async Task Cargar()
    {
        var version = ++versionCarga;
        var empresaId = Sesion.EmpresaId;
        producto = null;
        error = null;
        cargando = empresaId > 0;
        StateHasChanged();
        if (!cargando)
        {
            error = "No hay una empresa asociada a la sesión. Vuelva a iniciar sesión.";
            return;
        }
        var respuesta = await ProductoServicio.ObtenerPorIdAsync(Id, empresaId);
        if (version != versionCarga || empresaId != Sesion.EmpresaId) return;
        if (respuesta.Error || respuesta.Respuesta is null || respuesta.Respuesta.EmpresaId != empresaId)
            error = $"No se pudo cargar el producto en la empresa seleccionada. {respuesta.Mensaje}".Trim();
        else
            producto = respuesta.Respuesta;
        cargando = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        versionCarga++;
        Sesion.OnCambio -= AlCambiarEmpresa;
    }
}

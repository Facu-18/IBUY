@page "/depositos/{Id:int}"
@implements IDisposable
@inject IDepositoServicio DepositoServicio
@inject EstadoSesion Sesion

<PageTitle>@(deposito?.Nombre ?? "Deposito") · IBUY</PageTitle>

@if (cargando)
{
    <Cargando Texto="Cargando deposito..." />
}
else if (deposito is null)
{
    <div class="alert alert-danger" role="alert">
        No se encontro el deposito solicitado.
        <a class="alert-link" href="depositos">Volver al listado</a>
    </div>
}
else
{
    <div class="d-flex flex-wrap align-items-start justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1">@deposito.Nombre</h1>
            <p class="text-body-secondary mb-0">@deposito.Tipo · @deposito.Direccion</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary d-inline-flex align-items-center gap-2" href="depositos">
                <Icono Nombre="volver" /> Volver
            </a>
            <a class="btn btn-outline-primary d-inline-flex align-items-center gap-2" href="@($"depositos/editar/{deposito.Id}")">
                <Icono Nombre="editar" /> Editar
            </a>
            <button type="button"
                    class="btn @(deposito.Activo ? "btn-outline-warning" : "btn-outline-success")"
                    disabled="@guardando"
                    @onclick="AlternarEstado">
                @(deposito.Activo ? "Desactivar" : "Activar")
            </button>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <dl class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3 mb-0">
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Estado</dt>
                    <dd class="mb-0">
                        <span class="badge @(deposito.Activo ? "text-bg-success" : "text-bg-warning")">
                            @(deposito.Activo ? "Activo" : "Inactivo")
                        </span>
                    </dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Empresa</dt>
                    <dd class="mb-0">@deposito.EmpresaRazonSocial</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Tipo</dt>
                    <dd class="mb-0">@deposito.Tipo</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Direccion</dt>
                    <dd class="mb-0">@deposito.Direccion</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Responsable</dt>
                    <dd class="mb-0">@(string.IsNullOrWhiteSpace(deposito.UsuarioResponsableNombre) ? "Sin responsable" : deposito.UsuarioResponsableNombre)</dd>
                </div>
                <div class="col">
                    <dt class="small text-uppercase text-body-secondary">Productos con stock</dt>
                    <dd class="mb-0">@existencias.Count</dd>
                </div>
            </dl>
        </div>
    </div>

    <section>
        <div class="d-flex align-items-baseline justify-content-between mb-2">
            <h2 class="h5 mb-0">Existencias</h2>
            <span class="text-body-secondary">@existencias.Count @(existencias.Count == 1 ? "registro" : "registros")</span>
        </div>

        <div class="card shadow-sm">
            @if (cargandoStock)
            {
                <div class="card-body">
                    <Cargando Texto="Cargando existencias..." />
                </div>
            }
            else if (errorStock is not null)
            {
                <p class="text-center text-body-secondary py-5 mb-0">@errorStock</p>
            }
            else if (existencias.Count == 0)
            {
                <p class="text-center text-body-secondary py-5 mb-0">Este deposito no tiene existencias registradas.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Producto</th>
                                <th>Categoria</th>
                                <th class="text-end">Cantidad actual</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in existencias)
                            {
                                <tr @key="item.StockId">
                                    <td class="fw-semibold">@item.ProductoNombre</td>
                                    <td><span class="badge text-bg-primary">@item.Categoria</span></td>
                                    <td class="text-end">@item.CantidadActual.ToString("0.##")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </section>
}

@if (aviso is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show text-bg-dark border-0" role="status">
            <div class="toast-body">@aviso</div>
        </div>
    </div>
}

@code {
    [Parameter]
    public int Id { get; set; }

    private DepositoDTO? deposito;
    private List<StockDepositoDTO> existencias = [];
    private bool cargando = true;
    private bool cargandoStock = true;
    private bool guardando;
    private string? errorStock;
    private string? aviso;

    protected override async Task OnInitializedAsync()
    {
        Sesion.OnCambio += AlCambiarSesion;
        await Cargar();
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(Cargar);
    }

    private async Task Cargar()
    {
        cargando = true;
        cargandoStock = true;
        errorStock = null;
        StateHasChanged();

        var respuesta = await DepositoServicio.ObtenerPorIdAsync(Id);
        deposito = respuesta.Error ? null : respuesta.Respuesta;
        cargando = false;
        StateHasChanged();

        if (deposito is null)
        {
            cargandoStock = false;
            return;
        }

        var stock = await DepositoServicio.ObtenerStockAsync(Id);
        if (stock.Error)
        {
            existencias = [];
            errorStock = $"No se pudieron cargar las existencias. {stock.Mensaje}".Trim();
        }
        else
        {
            existencias = stock.Respuesta ?? [];
        }

        cargandoStock = false;
        StateHasChanged();
    }

    private async Task AlternarEstado()
    {
        if (deposito is null)
        {
            return;
        }

        guardando = true;

        var actualizado = new DepositoDTO
        {
            Id = deposito.Id,
            Nombre = deposito.Nombre,
            Tipo = deposito.Tipo,
            Direccion = deposito.Direccion,
            Activo = !deposito.Activo,
            EmpresaId = deposito.EmpresaId,
            UsuarioResponsableId = deposito.UsuarioResponsableId
        };

        var respuesta = await DepositoServicio.EditarAsync(deposito.Id, actualizado);

        if (respuesta.Error || !respuesta.Respuesta)
        {
            await MostrarAviso($"No se pudo actualizar {deposito.Nombre}. {respuesta.Mensaje}".Trim());
        }
        else
        {
            deposito.Activo = actualizado.Activo;
            await MostrarAviso(actualizado.Activo
                ? $"{deposito.Nombre} activado."
                : $"{deposito.Nombre} desactivado.");
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task MostrarAviso(string texto)
    {
        aviso = texto;
        StateHasChanged();

        await Task.Delay(3500);

        if (aviso == texto)
        {
            aviso = null;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Sesion.OnCambio -= AlCambiarSesion;
    }
}

@page "/depositos/nuevo"
@page "/depositos/editar/{Id:int}"
@inject IDepositoServicio DepositoServicio
@inject ICatalogoServicio CatalogoServicio
@inject EstadoSesion Sesion
@inject NavigationManager Navegacion

<PageTitle>@(esEdicion ? "Editar deposito" : "Nuevo deposito") · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">@(esEdicion ? "Editar deposito" : "Nuevo deposito")</h1>
    <p class="text-body-secondary mb-0">@(esEdicion ? "Actualiza los datos del deposito." : "Carga un deposito nuevo para la empresa seleccionada.")</p>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando formulario..." />
}
else if (deposito is null)
{
    <div class="alert alert-danger" role="alert">
        No se encontro el deposito solicitado.
        <a class="alert-link" href="depositos">Volver al listado</a>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(errorServidor))
    {
        <div class="alert alert-danger" role="alert">@errorServidor</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <EditForm Model="deposito" OnValidSubmit="Guardar" OnInvalidSubmit="MarcarInvalido">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="deposito-empresa">Empresa</label>
                    <input type="text" id="deposito-empresa" class="form-control" value="@Sesion.Empresa" disabled />
                    <div class="form-text">El deposito se crea dentro de la empresa seleccionada en el encabezado.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="deposito-nombre">Nombre</label>
                    <InputText id="deposito-nombre" class="form-control" @bind-Value="deposito!.Nombre" maxlength="100" placeholder="Ej.: Deposito central" />
                    <ValidationMessage class="text-danger small" For="() => deposito!.Nombre" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="deposito-tipo">Tipo</label>
                    <InputText id="deposito-tipo" class="form-control" @bind-Value="deposito!.Tipo" maxlength="50" placeholder="Ej.: Central, Obra, Sucursal" />
                    <ValidationMessage class="text-danger small" For="() => deposito!.Tipo" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="deposito-direccion">Direccion</label>
                    <InputText id="deposito-direccion" class="form-control" @bind-Value="deposito!.Direccion" maxlength="200" placeholder="Ej.: Av. Colon 1450, Cordoba" />
                    <ValidationMessage class="text-danger small" For="() => deposito!.Direccion" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="deposito-responsable">Responsable (opcional)</label>
                    <select id="deposito-responsable" class="form-select" value="@responsableSeleccionado" @onchange="AlCambiarResponsable">
                        <option value="">Sin responsable</option>
                        @foreach (var usuario in usuarios)
                        {
                            <option value="@usuario.Id">@usuario.Nombre</option>
                        }
                    </select>
                    @if (usuarios.Count == 0)
                    {
                        <div class="form-text">No hay usuarios activos en esta empresa.</div>
                    }
                </div>

                <div class="form-check mb-3">
                    <InputCheckbox @bind-Value="deposito!.Activo" id="deposito-activo" class="form-check-input" />
                    <label class="form-check-label" for="deposito-activo">Deposito activo</label>
                </div>

                @if (intentado)
                {
                    <div class="alert alert-danger" role="alert">
                        <ValidationSummary class="mb-0" />
                    </div>
                }

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" href="depositos">Cancelar</a>
                    <button type="submit" class="btn btn-primary" disabled="@guardando">
                        @(guardando ? "Guardando..." : "Guardar")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private DepositoDTO? deposito;
    private List<UsuarioOpcionDTO> usuarios = [];
    private string responsableSeleccionado = string.Empty;
    private bool cargando = true;
    private bool guardando;
    private bool intentado;
    private string? errorServidor;

    private bool esEdicion => Id.HasValue && Id.Value > 0;

    protected override async Task OnInitializedAsync()
    {
        deposito = new DepositoDTO
        {
            EmpresaId = Sesion.EmpresaId,
            Activo = true
        };

        var opciones = await CatalogoServicio.ObtenerUsuariosAsync(Sesion.EmpresaId);
        if (!opciones.Error)
        {
            usuarios = opciones.Respuesta ?? [];
        }

        if (esEdicion)
        {
            var respuesta = await DepositoServicio.ObtenerPorIdAsync(Id!.Value);
            if (respuesta.Error || respuesta.Respuesta is null)
            {
                errorServidor = $"No se encontro el deposito de id: {Id}. {respuesta.Mensaje}".Trim();
                deposito = null;
            }
            else
            {
                deposito = respuesta.Respuesta;
                responsableSeleccionado = deposito.UsuarioResponsableId?.ToString() ?? string.Empty;
            }
        }

        cargando = false;
    }

    private void AlCambiarResponsable(ChangeEventArgs e)
    {
        responsableSeleccionado = e.Value?.ToString() ?? string.Empty;
    }

    private void MarcarInvalido()
    {
        intentado = true;
    }

    private async Task Guardar()
    {
        if (deposito is null)
        {
            return;
        }

        intentado = false;
        guardando = true;
        errorServidor = null;

        deposito.EmpresaId = Sesion.EmpresaId;
        deposito.UsuarioResponsableId = int.TryParse(responsableSeleccionado, out var responsableId)
            ? responsableId
            : null;

        if (esEdicion)
        {
            var respuesta = await DepositoServicio.EditarAsync(Id!.Value, deposito);
            if (respuesta.Error || !respuesta.Respuesta)
            {
                errorServidor = $"No se pudo guardar el deposito. {respuesta.Mensaje}".Trim();
                guardando = false;
                return;
            }

            Navegacion.NavigateTo($"depositos/{Id!.Value}");
            return;
        }

        var creacion = await DepositoServicio.CrearAsync(deposito);
        if (creacion.Error)
        {
            errorServidor = $"No se pudo crear el deposito. {creacion.Mensaje}".Trim();
            guardando = false;
            return;
        }

        Navegacion.NavigateTo($"depositos/{creacion.Respuesta}");
    }
}

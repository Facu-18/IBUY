@page "/"
@page "/depositos"
@implements IDisposable
@inject IDepositoServicio DepositoServicio
@inject EstadoSesion Sesion

<PageTitle>Depositos · IBUY</PageTitle>

<div class="mb-4">
    <h1 class="h3 mb-1">Depositos</h1>
    <p class="text-body-secondary mb-0">Depositos donde cada empresa almacena su mercaderia.</p>
</div>

@if (cargando)
{
    <Cargando Texto="Cargando depositos..." />
}
else if (errorCarga is not null)
{
    <div class="alert alert-danger" role="alert">@errorCarga</div>
}
else
{
    <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
        <div class="col-12 col-md-6 col-lg-4">
            <label class="input-group">
                <span class="input-group-text"><Icono Nombre="buscar" /></span>
                <input type="text" class="form-control" placeholder="Buscar por nombre, direccion o responsable"
                       aria-label="Buscar depositos" @bind="busqueda" @bind:event="oninput" />
            </label>
        </div>
        <span class="text-body-secondary">@filtrados.Count @(filtrados.Count == 1 ? "deposito" : "depositos")</span>
        <a class="btn btn-primary d-inline-flex align-items-center gap-2 ms-md-auto" href="depositos/nuevo">
            <Icono Nombre="mas" />
            Nuevo deposito
        </a>
    </div>

    <div class="card shadow-sm">
        @if (depositos.Count == 0)
        {
            <p class="text-center text-body-secondary py-5 mb-0">
                @(Sesion.EmpresaId == 0
                    ? "No hay empresa seleccionada. Elija una empresa en el encabezado para ver sus depositos."
                    : "La empresa seleccionada todavia no tiene depositos cargados.")
            </p>
        }
        else if (filtrados.Count == 0)
        {
            <p class="text-center text-body-secondary py-5 mb-0">Sin resultados para la busqueda.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Tipo</th>
                            <th>Direccion</th>
                            <th>Responsable</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var deposito in filtrados)
                        {
                            <tr @key="deposito.Id">
                                <td class="fw-semibold">@deposito.Nombre</td>
                                <td>@deposito.Tipo</td>
                                <td>@deposito.Direccion</td>
                                <td>@(string.IsNullOrWhiteSpace(deposito.UsuarioResponsableNombre) ? "Sin responsable" : deposito.UsuarioResponsableNombre)</td>
                                <td>
                                    <span class="badge @(deposito.Activo ? "text-bg-success" : "text-bg-warning")">
                                        @(deposito.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="@($"depositos/{deposito.Id}")">
                                            <Icono Nombre="ver" /> Ver
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1" href="@($"depositos/editar/{deposito.Id}")">
                                            <Icono Nombre="editar" /> Editar
                                        </a>
                                        <button type="button"
                                                class="btn btn-sm @(deposito.Activo ? "btn-outline-warning" : "btn-outline-success")"
                                                disabled="@guardando"
                                                @onclick="() => AlternarEstado(deposito)">
                                            @(deposito.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

@if (aviso is not null)
{
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div class="toast show text-bg-dark border-0" role="status">
            <div class="toast-body">@aviso</div>
        </div>
    </div>
}

@code {
    private List<DepositoDTO> depositos = [];
    private List<DepositoDTO> filtrados => string.IsNullOrWhiteSpace(busqueda)
        ? depositos
        : [.. depositos.Where(d => Coincide(d, busqueda))];

    private string busqueda = string.Empty;
    private bool cargando = true;
    private bool guardando;
    private string? errorCarga;
    private string? aviso;

    protected override async Task OnInitializedAsync()
    {
        Sesion.OnCambio += AlCambiarSesion;
        await Cargar();
    }

    private void AlCambiarSesion()
    {
        _ = InvokeAsync(Cargar);
    }

    private async Task Cargar()
    {
        cargando = true;
        errorCarga = null;
        StateHasChanged();

        if (Sesion.EmpresaId == 0)
        {
            // Todavia no se cargo ninguna empresa: no se pide nada al servidor.
            depositos = [];
            cargando = false;
            StateHasChanged();
            return;
        }

        var respuesta = await DepositoServicio.ObtenerTodosAsync(Sesion.EmpresaId);

        if (respuesta.Error)
        {
            depositos = [];
            errorCarga = $"No se pudieron cargar los depositos. {respuesta.Mensaje}".Trim();
        }
        else
        {
            depositos = respuesta.Respuesta ?? [];
        }

        cargando = false;
        StateHasChanged();
    }

    private static bool Coincide(DepositoDTO deposito, string texto)
    {
        var filtro = texto.Trim().ToLowerInvariant();
        return deposito.Nombre.ToLowerInvariant().Contains(filtro)
            || deposito.Tipo.ToLowerInvariant().Contains(filtro)
            || deposito.Direccion.ToLowerInvariant().Contains(filtro)
            || deposito.UsuarioResponsableNombre.ToLowerInvariant().Contains(filtro);
    }

    private async Task AlternarEstado(DepositoDTO deposito)
    {
        guardando = true;

        var actualizado = new DepositoDTO
        {
            Id = deposito.Id,
            Nombre = deposito.Nombre,
            Tipo = deposito.Tipo,
            Direccion = deposito.Direccion,
            Activo = !deposito.Activo,
            EmpresaId = deposito.EmpresaId,
            UsuarioResponsableId = deposito.UsuarioResponsableId
        };

        var respuesta = await DepositoServicio.EditarAsync(deposito.Id, actualizado);

        if (respuesta.Error || !respuesta.Respuesta)
        {
            await MostrarAviso($"No se pudo actualizar {deposito.Nombre}. {respuesta.Mensaje}".Trim());
        }
        else
        {
            // La operacion se refleja en el listado sin volver a pedir los datos.
            deposito.Activo = actualizado.Activo;
            await MostrarAviso(actualizado.Activo
                ? $"{deposito.Nombre} activado."
                : $"{deposito.Nombre} desactivado.");
        }

        guardando = false;
        StateHasChanged();
    }

    private async Task MostrarAviso(string texto)
    {
        aviso = texto;
        StateHasChanged();

        await Task.Delay(3500);

        if (aviso == texto)
        {
            aviso = null;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Sesion.OnCambio -= AlCambiarSesion;
    }
}
